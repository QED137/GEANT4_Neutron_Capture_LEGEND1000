#
# run_gd.mac -- 0.1% Gd-doped water, 2.5 MeV neutrons (the 90% capture run)
#
/control/verbose 2
/run/verbose 2
#
/testhadr/det/setMat WaterGd_ts
/testhadr/det/setRadius 30 cm
#
/run/initialize
#
/analysis/setFileName gd_0p1pct
/analysis/h1/set 10 200 0. 20. MeV   # excited Gd-156/158 nuclei land here
/analysis/h1/set  2 100 0. 30. cm
/analysis/h1/set 24 150 0. 300. cm
/analysis/h1/set 25 200 0. 1000. microsecond
/analysis/h1/set 26 100 0. 30. cm
#
/gun/particle neutron
/gun/energy 2.5 MeV
#
/run/printProgress 10000
/run/beamOn 100000
