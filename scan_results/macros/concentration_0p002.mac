/control/verbose 0
/run/verbose 0
/testhadr/det/setRadius 30 cm
/testhadr/det/setGdFraction 0.002
/run/initialize
/analysis/setFileName concentration_0p002
/analysis/h1/set 24 150 0. 300. cm
/analysis/h1/set 25 200 0. 1000. microsecond
/analysis/h1/set 26 100 0. 30. cm
/gun/particle neutron
/gun/energy 2.5 MeV
/run/beamOn 10000
